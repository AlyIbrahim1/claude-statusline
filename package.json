    "context-window",
    "rate-limit",
    "git",
    "developer-tools",
    "productivity",
    "rust"
  ],
  "homepage": "https://github.com/AlyIbrahim1/claude-statusline#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlyIbrahim1/claude-statusline.git"
  },
